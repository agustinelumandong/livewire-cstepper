{
    "name": "agustinelumandong/livewire-cstepper",
    "description": "Laravel Livewire CStepper [Modern Multi-Step Form] component.",
    "keywords": [
        "Laravel",
        "livewire",
        "multi-steps",
        "cstepper",
        "form"
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/contracts": "^11.0",
        "livewire/livewire": "^3.6",
        "spatie/laravel-package-tools": "^1.92",
        "wireui/wireui": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "agustinelumandong\\LivewireCstepper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "agustinelumandong\\LivewireCstepper\\StepperServiceProvider"
            ],
            "aliases": {
                "LivewireCstepper": "agustinelumandong\\LivewireCstepper\\Facades\\LivewireCstepper"
            }
        }
    },
    "homepage": "https://github.com/agustinelumandong/livewire-cstepper",
    "authors": [
        {
            "name": "Cshan",
            "email": "agustinelumandong@gmail.com"
        }
    ],
    "license": "MIT",
    "require-dev": {
        "orchestra/testbench": "^9.15",
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "agustinelumandong\\LivewireCstepper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint"
    }
}
